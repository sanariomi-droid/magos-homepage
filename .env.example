# MAGOS 홈페이지 v3.3.0 환경변수 예시
# 실제 값은 GitHub 파일이 아니라 Vercel 프로젝트의 Environment Variables에 등록합니다.

# 공개용 PoC PDF. 정식 PoC 앱 배포 후 해당 URL로 변경할 수 있습니다.
VITE_LEDGERPROOF_URL=/documents/MAGOS_LedgerProof_PoC_v0.1.pdf

# Vercel Function(api/contact.js)용 EmailJS 설정
EMAILJS_SERVICE_ID=service_grnbxc8
EMAILJS_TEMPLATE_ID=template_ry142uj
EMAILJS_PUBLIC_KEY=GvUELP6idsY4ppGNa

# 선택사항: EmailJS 계정에서 Private Key 사용을 강제한 경우에만 Vercel에 등록합니다.
# GitHub 또는 프런트엔드 VITE_ 변수로 공개하지 않습니다.
EMAILJS_PRIVATE_KEY=

# 기존 Vercel 환경변수와의 호환을 위해 api/contact.js는 아래 이름도 읽습니다.
# 신규 설정에서는 위의 EMAILJS_* 이름을 권장합니다.
# VITE_EMAILJS_SERVICE_ID=service_grnbxc8
# VITE_EMAILJS_TEMPLATE_ID=template_ry142uj
# VITE_EMAILJS_PUBLIC_KEY=GvUELP6idsY4ppGNa
